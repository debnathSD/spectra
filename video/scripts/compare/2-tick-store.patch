+// The tick lives in a tiny store so only the components that show it re-render,
+// instead of the whole App every 50ms.
+let tickValue = 0;
+const tickListeners = new Set();
+function subscribeTick(listener) {
+  tickListeners.add(listener);
+  if (tickListeners.size === 1) {
+    subscribeTick.id = setInterval(() => {
+      tickValue += 1;
+      tickListeners.forEach(l => l());
+    }, 50);
+  }
+  return () => {
+    tickListeners.delete(listener);
+    if (tickListeners.size === 0) clearInterval(subscribeTick.id);
+  };
+}
+const useTick = () => useSyncExternalStore(subscribeTick, () => tickValue);
+
+function TickHeading() {
+  return <h1>Perf demo (tick {useTick()})</h1>;
+}
+
+function TickChart() {
+  return <Chart tick={useTick()} />;
+}
