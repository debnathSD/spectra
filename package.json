{
  "name": "@progen-labs/spectra",
  "version": "0.6.1",
  "description": "Spectra — a Chrome DevTools Protocol profiler that identifies the files, functions and components causing frontend slowness, across React, Vue, Svelte, Angular and Next.js builds.",
  "type": "module",
  "bin": {
    "spectra": "bin/spectra.js"
  },
  "main": "server/recorder.js",
  "exports": {
    ".": "./server/recorder.js",
    "./result": "./shared/result.js",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "server",
    "shared",
    "schema",
    "agents",
    "src",
    "dist",
    "index.html",
    "vite.config.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "spectra": "node bin/spectra.js",
    "dev": "vite",
    "build": "vite build",
    "prepack": "npm run build",
    "demo": "vite --config fixtures/demo-app/vite.config.js",
    "profile": "node server/cli.js",
    "test": "node --test \"server/**/test-*.js\" \"action/test-*.js\"",
    "test:vscode": "npm --prefix vscode test",
    "bench": "node bench/run.mjs",
    "size": "npm run build && node scripts/size-report.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "performance",
    "profiler",
    "profiling",
    "cdp",
    "chrome-devtools-protocol",
    "frontend",
    "web-vitals",
    "react",
    "vue",
    "svelte",
    "angular",
    "nextjs",
    "spectra",
    "progen-labs",
    "mcp",
    "mcp-server",
    "claude-code",
    "ai"
  ],
  "author": "Progen Labs (Sourav Debnath)",
  "license": "MIT",
  "homepage": "https://github.com/progen-labs/spectra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/progen-labs/spectra.git"
  },
  "bugs": {
    "url": "https://github.com/progen-labs/spectra/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
    "puppeteer-core": "^25.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@size-limit/file": "^14.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "d3": "^7.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "highlight.js": "^11.10.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^14.2.0",
    "vite": "^8.3.4"
  },
  "size-limit": [
    {
      "name": "Dashboard JavaScript (brotli)",
      "path": "dist/assets/*.js",
      "limit": "115 kB"
    },
    {
      "name": "Dashboard CSS (brotli)",
      "path": "dist/assets/*.css",
      "limit": "10 kB"
    }
  ]
}
